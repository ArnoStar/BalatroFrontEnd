# Settings of the whole site in Docker (docker-compose.yml; `make up`).
# Copy to .env (never commit it: it holds secrets). On the server it is
# /opt/balatro/BalatroFrontEnd/.env, which deployments keep.

# ---------------------------------------------------------------- the site
# the port players connect to, and the site's address as they type it (the
# sign-in tokens' issuer is PUBLIC_URL/identity, Google's redirect
# PUBLIC_URL/auth/callback)
WEB_PORT=8087
PUBLIC_URL=http://localhost:8087

# optional services: mail (Mailpit, an inbox for the emails at
# http://localhost:8025; with EMAIL_BACKEND=smtp and SMTP_HOST=mailpit below)
COMPOSE_PROFILES=

# ---------------------------------------------------------------- the API
# 1: test helpers (money, jokers, bosses) for front-end work. Never on a server.
BALATRO_API_DEBUG_COMMANDS=0
# set it empty to run without sign-in (everyone is one player)
#BALATRO_API_AUTH_JWKS_URL=
# the API's port on this machine (127.0.0.1 only), for its docs at /docs
API_PORT=8000
# the API's public address, only if it isn't this site's /api/
#API_URL=
# set a long random one on a server
API_DB_PASSWORD=balatro

# ---------------------------------------------------------------- the developers
# account ids (the identity service's, comma-separated; an account's id is in
# /reports/v1/me once signed in): they read the bug reports (/bugs) and the API
# rebuilds runs from them for them
ADMINS=

# ---------------------------------------------------------------- bug reports
REPORTS_PORT=8003
# set a long random one on a server
REPORTS_DB_PASSWORD=reports

# ---------------------------------------------------------------- the identity service
IDENTITY_PORT=8001
# set a long random one on a server
IDENTITY_DB_PASSWORD=identity
IDENTITY_DB_PORT=55432
IDENTITY_REDIS_PORT=56379

# ---------------------------------------------------------------- the notification service
# it sends the emails (the identity service hands it the codes through RabbitMQ):
# console (in `docker compose logs notification`) or smtp.
# With Mailpit (COMPOSE_PROFILES=mail): EMAIL_BACKEND=smtp, SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_SECURITY=none.
EMAIL_BACKEND=console
EMAIL_FROM=Balatro <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) or none
SMTP_SECURITY=starttls
NOTIFICATION_PORT=8002
# set a long random one on a server
RABBITMQ_PASSWORD=balatro

# Google sign-in: on when both are set (BalatroIndentityService's README,
# "Google sign-in"). Register PUBLIC_URL/auth/callback at Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
