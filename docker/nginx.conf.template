# The built game at /play/, and the API behind /api/ on the same origin (the
# game calls /api/v1/... when no API URL is set). Players come in through the
# portal (BalatroPortal), whose nginx passes /play/ here; on its own, / goes to
# /play/. The API's origin and prefix
# (from API_UPSTREAM, see api-upstream.envsh) and its DNS resolver are filled
# in when the container starts (nginx image templates).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/octet-stream;

    # the API's address is looked up again as it changes (a redeployed API
    # container gets a new one): Docker's DNS by default
    resolver ${API_RESOLVER} valid=10s ipv6=off;

    # API_UPSTREAM, split by api-upstream.envsh: /api/v1/x goes to
    # API_ORIGIN + API_PREFIX + /api/v1/x
    location /api/ {
        set $api_upstream ${API_ORIGIN};
        rewrite ^/(.*)$ ${API_PREFIX}/$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # the API's own host name (an API elsewhere may be one of several sites), and SNI over https
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite's hashed bundles never change
    location /play/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /play/ {
        try_files $uri $uri/ /play/index.html;
    }

    location = / {
        return 302 /play/;
    }
}
